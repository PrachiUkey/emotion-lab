# Copy to web/.env.local for local dev (gitignored). On Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# Shared password for the team. Also used to sign the auth cookie.
DASHBOARD_PASSWORD=<choose-a-strong-password>

# Where data lives: "local:/abs/path/to/data_store" (dev) or "r2:dump-bucket/emotion-lab" (prod)
EMOTION_LAB_STORE=r2:dump-bucket/emotion-lab

# R2 (prefer a read-only token scoped to the emotion-lab prefix)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<read-only-key-id>
R2_SECRET_ACCESS_KEY=<read-only-secret>
